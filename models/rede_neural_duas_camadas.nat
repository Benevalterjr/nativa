# Simple feed-forward neural network in Nativa
# Two dense layers: input -> hidden layer (ReLU) -> output (sigmoid)
# Run with: python nativa.py models/rede_neural_duas_camadas.nat --run

fn main():
    # One sample with two features.
    entrada = tensor([0.8, -0.3])

    # First layer weights: 2 inputs -> 3 hidden neurons.
    pesos_ocultos = tensor([
        [0.5, -0.2],
        [0.3, 0.8],
        [-0.6, 0.4]
    ])
    vieses_ocultos = tensor([0.1, -0.1, 0.2])

    # Output layer weights: 3 hidden neurons -> 1 output.
    pesos_saida = tensor([[0.7, -0.5, 0.9]])
    vieses_saida = tensor([0.05])

    # Forward pass: z1 = xW1^T + b1; a1 = ReLU(z1).
    ocultos = relu(pesos_ocultos @ entrada + vieses_ocultos)

    # Binary output between 0 and 1 using the sigmoid function.
    logits = pesos_saida @ ocultos + vieses_saida
    previsao = sigmoid(logits)

    print(f"Input: {entrada}")
    print(f"Hidden layer activations: {ocultos}")
    print(f"Predicted probability: {previsao}")
