# models/benchmark_rigoroso.nat
# Rigorous Scientific Benchmark in Nativa v0.4
# Evaluates memory, latency statistics, and fidelity with real Qwen2.5 tokens

fn main():
    print("==========================================================================")
    print("  NATIVA v0.4: RIGOROUS BENCHMARK OF KERNELS AND NUMERICAL FIDELITY")
    print("==========================================================================")

    arquivo = "data/qwen2.5_0.5b.safetensors"
    if not exists_file(arquivo):
        if exists_file("qwen2.5_0.5b.safetensors"):
            arquivo = "qwen2.5_0.5b.safetensors"
        else:
            print("[WARNING] Weights file not found:")
            print(f"        {arquivo}")
            print("To download the Qwen2.5-0.5B model, run the utility:")
            print("  python tools/baixar_qwen.py")
            return

    # Load real weights from critical projections
    print("[*] Loading real matrices from Layer 0...")
    w_gate = load_safetensors(arquivo, "model.layers.0.mlp.gate_proj.weight")
    w_down = load_safetensors(arquivo, "model.layers.0.mlp.down_proj.weight")
    norm1  = load_safetensors(arquivo, "model.layers.0.input_layernorm.weight")
    emb    = load_safetensors(arquivo, "model.embed_tokens.weight")

    # Quantization and packing
    print("[*] Quantizing and packing into 5-trits (Base-3)...")
    w_gate_q = quantize_bitnet(w_gate)
    w_gate_p = pack_ternary_5trits(w_gate_q)

    w_down_q = quantize_bitnet(w_down)
    w_down_p = pack_ternary_5trits(w_down_q)

    print(f"    - gate_proj: FP32 shape={shape(w_gate)} | Packed shape={shape(w_gate_p)}")
    print(f"    - down_proj: FP32 shape={shape(w_down)} | Packed shape={shape(w_down_p)}")

    # Latency test with warm-up
    print("\n[*] Latency Benchmark with Warm-up (gate_proj [4864 x 896])...")
    x = randn(896)

    # Warm-up
    for _ in 0..10:
        w_gate @ x
        w_gate_p @ x

    # FP32 Measurement
    t0 = clock()
    for _ in 0..50:
        w_gate @ x
    t_f32 = (clock() - t0) / 50.0

    # 5-trits Vec-LUT Measurement
    t0 = clock()
    for _ in 0..50:
        w_gate_p @ x
    t_p5 = (clock() - t0) / 50.0

    print(f"    - Average FP32 time:           {t_f32 * 1000.0:.3f} ms")
    print(f"    - Average 5-trits Vec-LUT time: {t_p5 * 1000.0:.3f} ms")

    # Fidelity evaluation with 3 different real tokens
    print("\n[*] Fidelity Evaluation with Real Vocabulary Tokens:")
    tokens = [9924, 1500, 50000]

    for tid in tokens:
        x_raw = emb[tid]
        xn = rmsnorm(x_raw, norm1)
        out_f = w_gate @ xn
        out_p = w_gate_p @ xn

        c_sim = cosine_sim(out_f, out_p)
        p_cor = pearson_corr(out_f, out_p)
        m_err = mae(out_f, out_p)

        print(f"    - Token {tid:5d}: Cosine={c_sim:.4f} | Pearson={p_cor:.4f} | MAE={m_err:.4f}")

    print("\n==========================================================================")
    print("  RIGOROUS BENCHMARK COMPLETED!")
    print("==========================================================================")
