# mini_llm_mha_real.nat
# Real Multi-Head Attention (4 Heads) + Complete KV Cache + Explicit BitNet AbsMean + Stochastic Sampling

fn main():
    print("==========================================================================")
    print("  MINI LLM V0.4 — REAL MULTI-HEAD ATTENTION & COMPLETE KV CACHE")
    print("  4 Independent Heads | Full History in SDPA | Top-P Sampling")
    print("==========================================================================")

    # Hyperparameters
    d_model   = 64
    n_heads   = 4
    dim_head  = 16       # d_model = n_heads * dim_head
    d_ff      = 256
    max_seq   = 128
    n_new_tokens = 10

    # 1. Tokenizer & Dynamic Vocabulary (No clamping!)
    tok = Tokenizer()
    vocab_size = len(tok)
    prompt = "Nativa e uma linguagem para IA"
    tokens = encode(tok, prompt)
    prompt_len = len(tokens)

    print(f"\n[1] Tokenizer:")
    print(f"    Exact vocab size:   {vocab_size} (no clamps or modulo!)")
    print(f"    Prompt:             \"{prompt}\"")
    print(f"    Prompt tokens:      {tokens}")
    print(f"    Seq len:            {prompt_len}")

    # 2. Initialization and BitNet Quantization with Explicit Gamma
    print("\n[2] Initializing Weights with Explicit AbsMean Scale Factors (gamma):")
    emb = randn([vocab_size, d_model]) * 0.02

    # Attention and MLP Projections (Layer 1)
    Wq1_raw = randn([d_model, d_model])
    Wk1_raw = randn([d_model, d_model])
    Wv1_raw = randn([d_model, d_model])
    Wo1_raw = randn([d_model, d_model])
    W1_1_raw = randn([d_model, d_ff])
    W2_1_raw = randn([d_ff, d_model])

    # Explicit gamma factors
    g_q1 = tensor_absmean(Wq1_raw)
    g_k1 = tensor_absmean(Wk1_raw)
    g_v1 = tensor_absmean(Wv1_raw)
    g_o1 = tensor_absmean(Wo1_raw)
    g_1_1 = tensor_absmean(W1_1_raw)
    g_2_1 = tensor_absmean(W2_1_raw)

    # Ternary weights {-1, 0, 1}
    Wq1 = quantize_bitnet(Wq1_raw)
    Wk1 = quantize_bitnet(Wk1_raw)
    Wv1 = quantize_bitnet(Wv1_raw)
    Wo1 = quantize_bitnet(Wo1_raw)
    W1_1 = quantize_bitnet(W1_1_raw)
    W2_1 = quantize_bitnet(W2_1_raw)

    g_attn1 = ones([d_model])
    g_mlp1  = ones([d_model])
    g_final = ones([d_model])
    lm_head = randn([d_model, vocab_size]) * 0.02

    print(f"    gamma_q: {g_q1:.6f} | gamma_k: {g_k1:.6f} | gamma_v: {g_v1:.6f}")
    print("    All linear weights converted to BitNet b1.58!")

    # 3. Independent KV Caches for the 4 Heads
    print(f"\n[3] Creating independent KV Cache for each of the {n_heads} heads...")
    c_k0 = KVCache(max_seq, dim_head)
    c_k1 = KVCache(max_seq, dim_head)
    c_k2 = KVCache(max_seq, dim_head)
    c_k3 = KVCache(max_seq, dim_head)

    # 4. Context Prefill
    print("\n[4] Prefill with Real Multi-Head Attention...")
    t_start = clock()
    x = zeros([d_model])

    for i in 0..prompt_len:
        tid = tokens[i]
        x = emb[tid]

        # RMSNorm + QKV with explicit gamma
        xn = rmsnorm(x, g_attn1)
        q_all = (xn @ Wq1) * g_q1
        k_all = (xn @ Wk1) * g_k1
        v_all = (xn @ Wv1) * g_v1

        # Slicing into 4 Heads (MHA)
        q0 = apply_rope(q_all[0..16], i)
        k0 = apply_rope(k_all[0..16], i)
        v0 = v_all[0..16]
        c_k0.update([k0], [v0])
        att0 = sdpa([q0], c_k0.k, c_k0.v)

        q1 = apply_rope(q_all[16..32], i)
        k1 = apply_rope(k_all[16..32], i)
        v1 = v_all[16..32]
        c_k1.update([k1], [v1])
        att1 = sdpa([q1], c_k1.k, c_k1.v)

        q2 = apply_rope(q_all[32..48], i)
        k2 = apply_rope(k_all[32..48], i)
        v2 = v_all[32..48]
        c_k2.update([k2], [v2])
        att2 = sdpa([q2], c_k2.k, c_k2.v)

        q3 = apply_rope(q_all[48..64], i)
        k3 = apply_rope(k_all[48..64], i)
        v3 = v_all[48..64]
        c_k3.update([k3], [v3])
        att3 = sdpa([q3], c_k3.k, c_k3.v)

        # Concatenation of the 4 Heads
        att_concat = concat([att0[0], att1[0], att2[0], att3[0]])
        x = x + ((att_concat @ Wo1) * g_o1)

        # MLP with explicit gamma
        xn = rmsnorm(x, g_mlp1)
        h = silu((xn @ W1_1) * g_1_1)
        x = x + ((h @ W2_1) * g_2_1)

    t_prefill = clock() - t_start
    print(f"    Prefill completed in {t_prefill * 1000.0:.2f} ms")
    print(f"    KV Cache seq_len per head: {c_k0.seq_len} tokens retained in full history!")

    # 5. Generation with Sampling (Temperature + Top-P) and Full KV Cache
    print(f"\n[5] Generating {n_new_tokens} tokens via Stochastic Sampling (T=0.8, Top-P=0.9):")
    t_gen_start = clock()
    x = rmsnorm(x, g_final)
    novos_tokens = []

    for step in 0..n_new_tokens:
        pos = prompt_len + step
        logits = x @ lm_head

        # Stochastic sampling without repetitive loops
        next_id = sample(logits, 0.8, 0.9)
        novos_tokens.append(next_id)

        print(f"      Step {step + 1:2d}: Token id = {next_id:4d} | Cache len = {c_k0.seq_len}")

        x = emb[next_id]

        # Multi-Head Attention with complete history of all previous positions
        xn = rmsnorm(x, g_attn1)
        q_all = (xn @ Wq1) * g_q1
        k_all = (xn @ Wk1) * g_k1
        v_all = (xn @ Wv1) * g_v1

        q0 = apply_rope(q_all[0..16], pos)
        k0 = apply_rope(k_all[0..16], pos)
        v0 = v_all[0..16]
        c_k0.update([k0], [v0])
        att0 = sdpa([q0], c_k0.k, c_k0.v)

        q1 = apply_rope(q_all[16..32], pos)
        k1 = apply_rope(k_all[16..32], pos)
        v1 = v_all[16..32]
        c_k1.update([k1], [v1])
        att1 = sdpa([q1], c_k1.k, c_k1.v)

        q2 = apply_rope(q_all[32..48], pos)
        k2 = apply_rope(k_all[32..48], pos)
        v2 = v_all[32..48]
        c_k2.update([k2], [v2])
        att2 = sdpa([q2], c_k2.k, c_k2.v)

        q3 = apply_rope(q_all[48..64], pos)
        k3 = apply_rope(k_all[48..64], pos)
        v3 = v_all[48..64]
        c_k3.update([k3], [v3])
        att3 = sdpa([q3], c_k3.k, c_k3.v)

        att_concat = concat([att0[0], att1[0], att2[0], att3[0]])
        x = x + ((att_concat @ Wo1) * g_o1)

        xn = rmsnorm(x, g_mlp1)
        h = silu((xn @ W1_1) * g_1_1)
        x = x + ((h @ W2_1) * g_2_1)

        x = rmsnorm(x, g_final)

    t_gen = clock() - t_gen_start
    print(f"\n    Total generation time: {t_gen * 1000.0:.2f} ms ({to_f64(n_new_tokens) / t_gen:.1f} tok/s)")
    texto_gerado = decode(tok, novos_tokens)
    print(f"    Generated tokens:       {novos_tokens}")
    print(f"    Generated text:         \"{texto_gerado}\"")

    print("\n==========================================================================")
    print("  ALL ARCHITECTURAL LIMITATIONS HAVE BEEN RESOLVED:")
    print("  [x] Real Multi-Head Attention (4 complete heads)")
    print("  [x] KV Cache with full attention history in SDPA")
    print("  [x] Explicit AbsMean scale factor (gamma) in BitNet")
    print("  [x] Dynamic vocabulary without clamping or modulo")
    print("  [x] Stochastic sampling with Temperature and Top-P")
    print("==========================================================================")
