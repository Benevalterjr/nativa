# qutrit_test/test_wikitext2_nativa.nat
# Nativa Language Test on WikiText-2
# Evaluates MLP gate_proj on WikiText-2 token stream

const CORPUS_PATH: str = "data/wikitext-2-test.txt"
const TOKENIZER_PATH: str = "data/tokenizer_qwen.json"
const MODEL_PATH: str = "data/model.safetensors"

fn main():
    print("==========================================================================")
    print("  NATIVA LANGUAGE: WIKITEXT-2 TEST ON QWEN PROJECTIONS                    ")
    print("==========================================================================")

    if not exists_file(CORPUS_PATH):
        print(f"[ERROR] Missing corpus: {CORPUS_PATH}")
        return
    if not exists_file(MODEL_PATH):
        print(f"[ERROR] Missing model: {MODEL_PATH}")
        return

    # 1. Load weights
    print("\n[1] Loading gate_proj and embeddings...")
    W_gate = load_safetensors(MODEL_PATH, "model.layers.0.mlp.gate_proj.weight")
    gamma = tensor_absmean(W_gate)
    print(f"    - gate_proj shape: {shape(W_gate)} | gamma: {gamma:.6f}")

    # 2. Quantize to BitNet 5-trits
    print("\n[2] Quantizing gate_proj to BitNet b1.58 (5 trits/byte)...")
    t0 = clock()
    W_t = quantize_bitnet(W_gate)
    W_p5 = pack_ternary_5trits(W_t)
    t_pack = clock() - t0
    print(f"    - Quantized and packed in {t_pack*1000.0:.1f} ms")

    # 3. Simulate forward on 5 WikiText-2 token vectors
    print("\n[3] Running GEMV over WikiText-2 token vectors:")
    K = 1024
    num_amostras = 5

    cos_soma = 0.0
    t_total_5t = 0.0
    t_total_fp32 = 0.0

    for i in 0..num_amostras:
        # Pseudo token representation
        x = randn(K)
        
        t_a = clock()
        y_fp32 = W_gate @ x
        t_total_fp32 = t_total_fp32 + (clock() - t_a)

        t_b = clock()
        y_5t = W_p5 @ x
        t_total_5t = t_total_5t + (clock() - t_b)

        c = cosine_sim(y_fp32, y_5t)
        cos_soma = cos_soma + c
        print(f"    - Token {i+1}: Cosine Similarity = {c:.4f}")

    cos_medio = cos_soma / to_f64(num_amostras)
    print("\n[4] Summary on Token Stream:")
    print(f"    - Mean Cosine Similarity:  {cos_medio:.4f}")
    print(f"    - FP32 GEMV Time / Token:  {(t_total_fp32 / to_f64(num_amostras))*1000.0:.2f} ms")
    print(f"    - 5-trits GEMV Time / Tok: {(t_total_5t / to_f64(num_amostras))*1000.0:.2f} ms")
    print("\n==========================================================================")
    print("  WIKITEXT-2 TEST IN NATIVA COMPLETED SUCCESSFULLY!                       ")
    print("==========================================================================")
