fn main():
    v = fill(8, 2.5)
    o = ones([8])
    z = zeros([8])
    
    s = sum(v)
    m = mean(v)
    d = dot(v, o)
    sz = sum(z)
    
    fatia = v[1..4]
    tam_fatia = len(fatia)
    primeiro_fatia = fatia[0]

    print(f"Sum v: {s:.1f}, Mean v: {m:.1f}, Dot: {d:.1f}, Sum z: {sz:.1f}")
    print(f"Slice len: {tam_fatia}, First in slice: {primeiro_fatia:.1f}")
