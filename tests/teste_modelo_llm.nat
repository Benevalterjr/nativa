# teste_modelo_llm.nat
# Validacao completa dos 4 novos recursos de modelos de linguagem em Nativa:
# 1. Tokenizador BPE nativo com Byte-Fallback
# 2. Scaled Dot-Product Attention (SDPA) com Causal Mask
# 3. KV Cache autoregressivo
# 4. RoPE e RMSNorm

fn main():
    print("==========================================================================")
    print("  NATIVA v0.3: RECURSOS NATIVOS PARA MODELOS DE LINGUAGEM (LLMs)")
    print("==========================================================================")

    # 1. Tokenizador BPE Nativo com Byte-Fallback
    print("\n[1] Teste do Tokenizador BPE com Byte-Fallback:")
    tok = Tokenizer()
    prompt = "Nativa v0.3 executa BitNet b1.58 e LLMs com tensores densos nativos!"
    tokens = encode(tok, prompt)
    texto_recuperado = decode(tok, tokens)

    print(f"    Prompt original:     \"{prompt}\"")
    print(f"    Tokens gerados:      {tokens}")
    print(f"    Total de tokens:     {len(tokens)}")
    print(f"    Texto decodificado:  \"{texto_recuperado}\"")

    # 2. Attention (SDPA) e Causal Mask
    print("\n[2] Scaled Dot-Product Attention (SDPA) com Mascara Causal:")
    seq_len = 4
    dim_head = 64
    Q = randn([seq_len, dim_head])
    K = randn([seq_len, dim_head])
    V = randn([seq_len, dim_head])
    mask = causal_mask(seq_len)

    saida_attn = sdpa(Q, K, V, mask)
    print(f"    Dimensao da saida SDPA: {shape(saida_attn)}")

    # 3. KV Cache para Inferencia Autoregressiva
    print("\n[3] KV Cache Autoregressivo Passo-a-Passo:")
    cache = KVCache(2048, dim_head)
    for passo in 0..3:
        k_step = randn([1, dim_head])
        v_step = randn([1, dim_head])
        cache.update(k_step, v_step)
        print(f"    Passo {passo + 1}: KV Cache seq_len = {cache.seq_len}")

    # 4. Normalizacao RMSNorm e Rotacao RoPE
    print("\n[4] RMSNorm e RoPE:")
    x = randn([dim_head])
    gamma = ones([dim_head])
    x_norm = rmsnorm(x, gamma)
    x_rot = apply_rope(x_norm, 1)
    print(f"    Vetor normalizado RMSNorm: shape = {shape(x_norm)}")
    print(f"    Vetor rotacionado RoPE:    shape = {shape(x_rot)}")

    print("\n==========================================================================")
    print("  TODOS OS 4 PILARES DE MODELOS FORAM VALIDADOS COM SUCESSO!")
    print("==========================================================================")
