import math

fn main():
    print("=== Teste Espectral Fourier em Nativa ===")
    
    # 1. Numeros Complexos
    c1 = Complex(3.0, 4.0)
    c2 = Complex(1.0, 2.0)
    c_soma = c1 + c2
    print("c1.real:", c1.real)
    print("c1.imag:", c1.imag)
    print("c_soma.real:", c_soma.real)
    print("c_soma.imag:", c_soma.imag)

    # 2. Transformada de Fourier 1D (rfft)
    sinal = [1.0, 2.0, 3.0, 4.0, 3.0, 2.0, 1.0, 0.0]
    spec = rfft(sinal)
    print("Frequencias no espectro:", len(spec))

    # 3. Densidade Espectral de Potencia (|X|^2)
    ps = power_spectrum(spec)
    print("Potencia DC (k=0):", ps[0])

    # 4. Transformada Inversa (irfft) - Reconstrucao Exata
    rec = irfft(spec)
    print("Tamanho do sinal reconstruido:", len(rec))
    
    # Validacao de reconstrucao
    diff = rec[0] - sinal[0]
    print("Diferenca na primeira amostra:", diff)
    print("=== Fourier concluido com sucesso ===")
