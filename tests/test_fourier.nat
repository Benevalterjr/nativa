    print("Frequencies in spectrum:", len(spec))

    # 3. Power Spectral Density (|X|^2)
    ps = power_spectrum(spec)
    print("DC Power (k=0):", ps[0])

    # 4. Inverse Transform (irfft) - Exact Reconstruction
    rec = irfft(spec)
    print("Reconstructed signal length:", len(rec))
    
    # Reconstruction validation
    diff = rec[0] - sinal[0]
