# riemann.nat
# Computation of non-trivial zeros of the Riemann Zeta Function on the critical line (s = 1/2 + it)
# Uses the Riemann-Siegel formula approximation (Hardy Z Function) and the Bisection Method.

const PI = 3.14159265358979323846

# Riemann-Siegel theta(t) function (phase of the Zeta function)
fn theta(t: f64) -> f64:
    return (
        0.5 * t * ln(t / (2.0 * PI))
        - 0.5 * t
        - PI / 8.0
        + 1.0 / (48.0 * t)
        + 7.0 / (5760.0 * t * t * t)
    )

# Approximation of Hardy's Z(t) function (where Z(t) = 0 corresponds to zeta(1/2 + it) = 0)
fn hardy_z_aprox(t: f64) -> f64:
    N: i64 = to_i64(floor(sqrt(t / (2.0 * PI))))
    fase = theta(t)
    soma = 0.0
    for n in 1..N + 1:
        nf = to_f64(n)
        soma += cos(fase - t * ln(nf)) / sqrt(nf)
    return 2.0 * soma

# Root refinement via the Bisection Method
fn bissecao(a_in: f64, b_in: f64) -> f64:
    a = a_in
    b = b_in
    fa = hardy_z_aprox(a)
    for passo in 0..60:
        meio = (a + b) / 2.0
        fm = hardy_z_aprox(meio)
        if fm == 0.0:
            return meio
        if fa * fm < 0.0:
            b = meio
        else:
            a = meio
            fa = fm
    return (a + b) / 2.0

fn main():
    inicio = 10.0
    fim = 100.0
    passo = 0.25

    print(f"=== Searching for Zeta Function Zeros on the Critical Line [t = {inicio} to {fim}] ===")
    
    anterior_t = inicio
    anterior_z = hardy_z_aprox(anterior_t)
    encontrados = 0
    t = inicio + passo

    while t <= fim:
        z = hardy_z_aprox(t)
        # Was there a sign change between anterior_t and t? (Intermediate Value Theorem)
        if anterior_z * z < 0.0:
            encontrados += 1
            raiz = bissecao(anterior_t, t)
            print(f"[{encontrados:2d}] Zero detected: t = {raiz:.6f}")
        anterior_t = t
        anterior_z = z
        t += passo

    print(f"=== Search completed: {encontrados} non-trivial zeros found ===")
