# teste_grande_safetensors.nat
# Large-scale test: loading 16 MB SafeTensors, BitNet 1.58-bit quantization,
# and Add-Only GEMM vector projection in Nativa

fn main():
    arquivo = "grande_modelo.safetensors"
    camada = "model.layers.0.mlp.gate_proj.weight"

    print("==================================================================")
    print("  LARGE-SCALE TEST: SAFETENSORS (16 MB) + BITNET 1.58-BIT         ")
    print("==================================================================")

    # 1. Inspecting keys in the binary file
    t0 = clock()
    chaves = safetensors_keys(arquivo)
    print(f"[1] Metadata successfully read:")
    print(f"    Available tensors: {chaves}")

    # 2. Loading the large tensor (1024 x 2048 = 2,097,152 elements)
    print(f"\n[2] Loading '{camada}' (1024 x 2048 floats ~ 8.4 MB)...")
    t1 = clock()
    W = load_safetensors(arquivo, camada)
    t2 = clock()
    tempo_load = t2 - t1
    sh = shape(W)
    print(f"    Tensor successfully loaded in {tempo_load:.4f}s!")
    print(f"    Tensor shape: {sh}")

    # 3. Quantization to Nativa's native 1.58-bit (weights {-1, 0, +1})
    print("\n[3] Quantizing 2,097,152 parameters to 1.58 bits (t2 / ternary)...")
    t3 = clock()
    W_t2 = quantize_ternary(W, 0.015)
    t4 = clock()
    tempo_quant = t4 - t3
    print(f"    Quantization completed in {tempo_quant:.4f}s!")

    # 4. In-memory compression (Bit Packing: 2 bits per trit = 4 trits/byte)
    print("\n[4] Packing matrix in memory (2 bits/trit bit-packing)...")
    t5 = clock()
    compactado = pack_ternary(W_t2)
    t6 = clock()
    tempo_pack = t6 - t5
    n_bytes = len(compactado)
    kb = to_f64(n_bytes) / 1024.0
    print(f"    Bit-packing completed in {tempo_pack:.4f}s!")
    print(f"    Original size (f32): ~8,192 KB (8.4 MB)")
    print(f"    Packed size (t2):    ~{kb:.1f} KB (0.5 MB)")
    print(f"    Memory savings:      ~16x smaller!")

    # 5. Add-Only GEMM inference with activation vector (dimension 2048)
    print("\n[5] Running Add-Only GEMM (W_t2 @ x) with 2048-element activation vector...")
    x = ones([2048])
    t7 = clock()
    y = W_t2 @ x
    t8 = clock()
    tempo_gemm = t8 - t7
    sh_y = shape(y)
    m = mean(y)
    v_max = max(y)
    v_min = min(y)

    print(f"    Matrix multiplication completed in {tempo_gemm:.4f}s!")
    print(f"    Output vector shape: {sh_y}")
    print(f"    Projection statistics:")
    print(f"      - Mean value:    {m:.4f}")
    print(f"      - Maximum value: {v_max:.4f}")
    print(f"      - Minimum value: {v_min:.4f}")

    tempo_total = t8 - t0
    print("\n==================================================================")
    print(f"  [SUCCESS] Full pipeline completed in {tempo_total:.3f}s!")
    print("==================================================================")
